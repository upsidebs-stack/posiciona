# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_TRUST_HOST=true                  # required in production (Netlify) — see DECISIONS.md
DATABASE_URL=                         # postgres://... (Neon)

# Google OAuth sign-in — optional. Only needed if you want "Sign in with
# Google" in addition to the magic-link email. Not in PLANO.md section 17
# (which only lists the Places API key); added because section 4 specifies
# Auth.js with "magic link + Google OAuth". See DECISIONS.md.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Modelo default. Só troque com medição de qualidade junto.
CLAUDE_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Google Places API (New)
# Restringir a chave por IP do servidor no console. NUNCA expor ao cliente:
# o autocomplete de endereço passa por /api/places/autocomplete.
# Franquia mensal por SKU: ~10k Essentials, ~5k Pro, ~1k Enterprise.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Billing — Merchant of Record, trocável via BillingProvider
# ---------------------------------------------------------------------------
BILLING_PROVIDER=PADDLE               # PADDLE | LEMONSQUEEZY | FAKE
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_ANNUAL=

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=
MAIL_PHYSICAL_ADDRESS=                # obrigatório no rodapé pelo CAN-SPAM

# ---------------------------------------------------------------------------
# Infra
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Guardrails de custo — o free tier gasta dinheiro real
# ---------------------------------------------------------------------------
MAX_COMPETITORS_FREE=25
MAX_COMPETITORS_PRO=60
MAX_SITE_FETCHES=12
MAX_MONTHLY_FREE_ANALYSES=500
